<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<GenerateAssemblyInfo>false</GenerateAssemblyInfo>

		<Authors>OpenTail</Authors>
		<GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
		<IsPackable>true</IsPackable>
		<AssemblyName>Transformations.Text</AssemblyName>
		<RootNamespace>Transformations</RootNamespace>
		<PackageId>Transformations.Text</PackageId>
		<Description>Multi-format text extraction and RAG preparation library for .NET — PDF, DOCX, PPTX, Excel, HTML, Markdown, JSON, YAML, CSV, EML, MSG, ODT, RTF, EPUB, ZIP, and more. Includes RAG chunking with provenance, table-mode control, and a fluent DI builder. Includes Tesseract OCR for images and scanned PDFs (Windows x64/x86) and AI-ingestion safety gates.</Description>
		<PackageTags>transformations;text;extraction;rag;ocr;tesseract;pdf;docx;pptx;xlsx;html;markdown;json;yaml;csv;eml;msg;odt;rtf;epub;zip;chunker</PackageTags>
		<PackageReadmeFile>README.md</PackageReadmeFile>

		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<EmbedUntrackedSources>true</EmbedUntrackedSources>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="CsvHelper" Version="33.1.0" />
		<PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
		<PackageReference Include="ExcelDataReader" Version="3.9.0" />
		<PackageReference Include="HtmlAgilityPack" Version="1.13.1" />
		<PackageReference Include="JsonSchema.Net" Version="9.4.1" />
		<PackageReference Include="Markdig" Version="1.4.2" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.13" />
		<PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.13" />
		<PackageReference Include="MimeKit" Version="4.18.2" />
		<PackageReference Include="MSGReader" Version="6.2.0" />
		<PackageReference Include="PdfPig" Version="0.1.16" />
		<!-- OCR (TesseractOcrEngine). The native Tesseract/Leptonica DLLs are copied by TesseractOCR's build/ targets,
		     which NuGet does not pass to indirect consumers by default; PrivateAssets="none" lets them flow so one
		     reference to Transformations.Text gives working OCR. -->
		<PackageReference Include="TesseractOCR" Version="5.5.2" PrivateAssets="none" />
		<PackageReference Include="YamlDotNet" Version="17.1.0" />
		<None Include="README.md" Pack="true" PackagePath="\" />
	</ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Consumer for the README smoke test. It references only the Transformations meta package, the way a user does, and
    runs the Quick Start examples from the root README. Pass -p:SmokeTfm=<tfm> and -p:SmokeVersion=<version>.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework Condition="'$(SmokeTfm)' != ''">$(SmokeTfm)</TargetFramework>
    <TargetFramework Condition="'$(SmokeTfm)' == ''">net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>Smoke.Readme</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Transformations" Version="$(SmokeVersion)" />
    <!-- The packages a user installs next to the meta package. The duplicate-type check runs over all of them. -->
    <PackageReference Include="Transformations.Core" Version="$(SmokeVersion)" />
    <PackageReference Include="Transformations.Data" Version="$(SmokeVersion)" />
    <PackageReference Include="Transformations.Web" Version="$(SmokeVersion)" />
    <PackageReference Include="Transformations.Dapper" Version="$(SmokeVersion)" />
    <PackageReference Include="Transformations.EntityFramework" Version="$(SmokeVersion)" />
    <PackageReference Include="Transformations.Mapping" Version="$(SmokeVersion)" />
    <PackageReference Include="Transformations.Text" Version="$(SmokeVersion)" />
    <PackageReference Include="Transformations.Audio" Version="$(SmokeVersion)" />
  </ItemGroup>

</Project>

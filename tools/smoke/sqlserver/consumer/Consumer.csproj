<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Consumer for the SQL Server smoke test. It references Transformations.Data, Dapper and EntityFramework packages and runs them
    against a real SQL Server (SQL Server LocalDB). Pass -p:SmokeTfm=<tfm> and -p:SmokeVersion=<version> from the runner.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework Condition="'$(SmokeTfm)' != ''">$(SmokeTfm)</TargetFramework>
    <TargetFramework Condition="'$(SmokeTfm)' == ''">net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>Smoke.SqlServer</AssemblyName>
    <!-- EF Core 9 matches Transformations.EntityFramework 9.0.21. -->
    <SmokeEfCoreVersion>9.0.21</SmokeEfCoreVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Transformations.Data" Version="$(SmokeVersion)" />
    <PackageReference Include="Transformations.Dapper" Version="$(SmokeVersion)" />
    <PackageReference Include="Transformations.EntityFramework" Version="$(SmokeVersion)" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="$(SmokeEfCoreVersion)" />
    <PackageReference Include="Dapper" Version="2.1.89" />
  </ItemGroup>

</Project>

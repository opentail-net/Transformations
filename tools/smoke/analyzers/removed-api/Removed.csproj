<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Calls a member the library removed in 3.0.0.0. This project must fail to compile with CS1061, and must not produce
    a TX0001 warning: the analyzer can only flag a member that still exists.
    Pass -p:SmokeVersion=<version> from the runner.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Smoke.Analyzers.Removed</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Transformations" Version="$(SmokeVersion)" />
  </ItemGroup>

</Project>

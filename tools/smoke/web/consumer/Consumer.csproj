<Project Sdk="Microsoft.NET.Sdk.Web">

  <!--
    Consumer for the Web smoke test. It hosts a small ASP.NET Core app in-process, uses the Transformations.Web helpers in its
    endpoints, and checks their behaviour over HTTP. Pass -p:SmokeTfm=<tfm> and -p:SmokeVersion=<version> from the runner.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework Condition="'$(SmokeTfm)' != ''">$(SmokeTfm)</TargetFramework>
    <TargetFramework Condition="'$(SmokeTfm)' == ''">net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>Smoke.Web</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Transformations.Web" Version="$(SmokeVersion)" />
  </ItemGroup>

</Project>

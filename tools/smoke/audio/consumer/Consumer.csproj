<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Consumer for the Audio smoke test. It references only the Transformations.Audio package and checks its output against
    signals with known answers. Pass -p:SmokeTfm=<tfm> and -p:SmokeVersion=<version> from the runner.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework Condition="'$(SmokeTfm)' != ''">$(SmokeTfm)</TargetFramework>
    <TargetFramework Condition="'$(SmokeTfm)' == ''">net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>Smoke.Audio</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Transformations.Audio" Version="$(SmokeVersion)" />
  </ItemGroup>

</Project>

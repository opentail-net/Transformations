<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Consumer for the Dapper and EF Core data smoke test. It references the Dapper and EntityFramework packages and runs them
    against SQLite, which is a real provider with real transient faults (busy locks) and real non-transient faults
    (constraint violations). Pass -p:SmokeTfm=<tfm> and -p:SmokeVersion=<version> from the runner.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework Condition="'$(SmokeTfm)' != ''">$(SmokeTfm)</TargetFramework>
    <TargetFramework Condition="'$(SmokeTfm)' == ''">net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>Smoke.DataProviders</AssemblyName>
  </PropertyGroup>

  <!-- The EF Core major must match the target framework, and the library resolves the same major on each one:
       EF Core 9 on net8.0 to net10.0 (Transformations.EntityFramework 9.0.21), EF Core 11 on net11.0. -->
  <PropertyGroup>
    <SmokeEfCoreVersion>9.0.21</SmokeEfCoreVersion>
    <SmokeEfCoreVersion Condition="'$(TargetFramework)' == 'net11.0'">11.0.0</SmokeEfCoreVersion>
  </PropertyGroup>

  <!-- EF Core 11 needs SQLitePCLRaw 3.x; the older targets take the version the SQLite provider brings in. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net11.0'">
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Transformations.Dapper" Version="$(SmokeVersion)" />
    <PackageReference Include="Transformations.EntityFramework" Version="$(SmokeVersion)" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="$(SmokeEfCoreVersion)" />
    <PackageReference Include="Dapper" Version="2.1.89" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="$(SmokeEfCoreVersion)" />
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Consumer for the Dapper and EF Core data smoke test. It references the Dapper and EntityFramework packages and runs them
    against SQLite, which is a real provider with real transient faults (busy locks) and real non-transient faults
    (constraint violations). Pass -p:SmokeTfm=<tfm> and -p:SmokeVersion=<version> from the runner.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework Condition="'$(SmokeTfm)' != ''">$(SmokeTfm)</TargetFramework>
    <TargetFramework Condition="'$(SmokeTfm)' == ''">net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>Smoke.DataProviders</AssemblyName>
    <!-- EF Core 9 matches Transformations.EntityFramework 9.0.21. -->
    <SmokeEfCoreVersion>9.0.21</SmokeEfCoreVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Transformations.Dapper" Version="$(SmokeVersion)" />
    <PackageReference Include="Transformations.EntityFramework" Version="$(SmokeVersion)" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="$(SmokeEfCoreVersion)" />
    <PackageReference Include="Dapper" Version="2.1.89" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.21" />
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Smoke-test consumer for the packed Transformations.Text package. Built by Run-TextSmoke.ps1 in a fresh folder.
    It references only the package, never the repository, and reads the committed corpus from disk.
    Pass -p:SmokeTfm=<tfm> and -p:SmokeTextVersion=<version> from the runner.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework Condition="'$(SmokeTfm)' != ''">$(SmokeTfm)</TargetFramework>
    <TargetFramework Condition="'$(SmokeTfm)' == ''">net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>Smoke.Text</RootNamespace>
    <AssemblyName>Smoke.Text</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Transformations.Text" Version="$(SmokeTextVersion)" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.13" />
  </ItemGroup>

</Project>

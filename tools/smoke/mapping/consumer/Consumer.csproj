<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Smoke-test consumer for Transformations.Mapping. Built by Run-MappingSmoke.ps1 inside a fresh
    work directory, never from the repository solution. Only package references are allowed here.
    Pass -p:SmokeTfm=<tfm> and -p:SmokeMappingVersion=<version> from the runner.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework Condition="'$(SmokeTfm)' != ''">$(SmokeTfm)</TargetFramework>
    <TargetFramework Condition="'$(SmokeTfm)' == ''">net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <RootNamespace>Smoke.Mapping</RootNamespace>
    <AssemblyName>Smoke.Mapping</AssemblyName>
  </PropertyGroup>

  <!-- EF Core major version must match the target framework. Versions are pinned for reproducibility. -->
  <PropertyGroup>
    <SmokeEfCoreVersion Condition="'$(TargetFramework)' == 'net8.0'">8.0.11</SmokeEfCoreVersion>
    <SmokeEfCoreVersion Condition="'$(TargetFramework)' == 'net9.0'">9.0.7</SmokeEfCoreVersion>
    <SmokeEfCoreVersion Condition="'$(TargetFramework)' == 'net10.0'">10.0.9</SmokeEfCoreVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Transformations.Mapping" Version="$(SmokeMappingVersion)" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="$(SmokeEfCoreVersion)" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.13" />
  </ItemGroup>

</Project>

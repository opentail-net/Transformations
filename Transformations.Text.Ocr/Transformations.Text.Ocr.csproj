<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<GenerateAssemblyInfo>false</GenerateAssemblyInfo>

		<Authors>OpenTail</Authors>
		<GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
		<IsPackable>true</IsPackable>
		<AssemblyName>Transformations.Text.Ocr</AssemblyName>
		<RootNamespace>Transformations.Text.Ocr</RootNamespace>
		<PackageId>Transformations.Text.Ocr</PackageId>
		<Description>Tesseract OCR for Transformations.Text: reads text from images and scanned PDF pages. Windows x64/x86 only; on other platforms it reports itself unavailable and never loads native code.</Description>
		<PackageTags>transformations;text;ocr;tesseract;rag</PackageTags>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>

		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<EmbedUntrackedSources>true</EmbedUntrackedSources>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\Transformations.TextExtractor\Transformations.Text.csproj" />
		<!-- The native DLLs are copied by TesseractOCR's build/ targets, which NuGet does not pass to indirect
		     consumers by default. PrivateAssets="none" lets them flow to projects that reference this package. -->
		<PackageReference Include="TesseractOCR" Version="5.5.2" PrivateAssets="none" />
		<None Include="README.md" Pack="true" PackagePath="\" />
	</ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <LangVersion>latestMajor</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
    <IsPackable>true</IsPackable>
    <AssemblyName>Transformations.Sql</AssemblyName>
    <RootNamespace>Transformations.Sql</RootNamespace>
    <PackageId>Transformations.Sql</PackageId>
    <Description>SQL Server transient fault classification shared by the Transformations data packages (Dapper, EntityFramework).</Description>
    <PackageTags>transformations;sql;sqlserver;transient;retry;resilience</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.1" />
  </ItemGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>
  <!-- Microsoft.Data.SqlClient pulls in System.Security.Cryptography.Pkcs versions with known vulnerabilities
       (GHSA-846f-f764-76mx, GHSA-2fmv-rv2c-59x7). Pin the patched release for each target framework. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="8.0.2" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' != 'net8.0'">
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="9.0.21" />
  </ItemGroup>
</Project>

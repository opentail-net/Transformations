<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0;net11.0</TargetFrameworks>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
	<GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
	<IsPackable>true</IsPackable>
	<AssemblyName>Transformations.EntityFramework</AssemblyName>
	<RootNamespace>Transformations.EntityFramework</RootNamespace>
	<PackageId>Transformations.EntityFramework</PackageId>
	<Description>EF Core resilience extensions - async SaveChanges retry, ChangeTracker audit logging, and IQueryable CSV export, powered by Transformations.Core.</Description>
	<PackageTags>transformations;entityframework;efcore;resilience;retry;audit;changelog;csv</PackageTags>
	<PackageReadmeFile>README.md</PackageReadmeFile>  
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Transformations.Core\Transformations.Core.csproj" />
    <ProjectReference Include="..\Transformations.Sql\Transformations.Sql.csproj" />
  </ItemGroup>
  <!-- net8.0 to net10.0 keep the EF Core 9 floor they have always shipped with. net11.0 takes the matching EF Core 11
       release, so the package does not pull an older EF Core onto the newest runtime. -->
  <ItemGroup Condition="'$(TargetFramework)' != 'net11.0'">
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="9.0.21" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net11.0'">
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="11.0.0" />
  </ItemGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>
</Project>



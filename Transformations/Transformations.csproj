<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <ImplicitUsings>disable</ImplicitUsings>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
	<GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
	<IsPackable>true</IsPackable>
	<AssemblyName>Transformations</AssemblyName>
	<RootNamespace>Transformations</RootNamespace>
	<PackageId>Transformations</PackageId>
	<Description>Modern .NET transformation helpers for conversion, strings, collections, data, web, diagnostics, batching, and resilience.</Description>
	<PackageTags>transformations;extensions;utilities;dotnet;batching;sanitization;diagnostics;resilience</PackageTags>
	<PackageReadmeFile>README.md</PackageReadmeFile>
	<DisableTransitiveProjectReferences>true</DisableTransitiveProjectReferences>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.1" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.13" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.13" />
  </ItemGroup>
  <ItemGroup>
    <!-- The shared helpers are compiled once, in Transformations.Core. Compiling them here as well put each type in two
         assemblies, and any consumer that referenced both got ambiguous calls (CS0121). -->
    <ProjectReference Include="..\Transformations.Core\Transformations.Core.csproj" />
    <ProjectReference Include="..\Transformations.Data\Transformations.Data.csproj" />
    <ProjectReference Include="..\Transformations.Web\Transformations.Web.csproj" />
    <ProjectReference Include="..\Transformations.Analyzers\Transformations.Analyzers.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\Transformations.Analyzers.CodeFixes\Transformations.Analyzers.CodeFixes.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\Transformations.Dapper\Transformations.Dapper.csproj" Aliases="TransformationsDapper" />
    <ProjectReference Include="..\Transformations.EntityFramework\Transformations.EntityFramework.csproj" Aliases="TransformationsEntityFramework" />
    <ProjectReference Include="..\Transformations.Mapping\Transformations.Mapping.csproj" Aliases="TransformationsMapping" />
    <ProjectReference Include="..\Transformations.TextExtractor\Transformations.Text.csproj" Aliases="TransformationsText" />
  </ItemGroup>
  <!-- Each type is defined once. Core, Data and Web own their files; this project only holds what none of them compile. -->
  <ItemGroup>
    <Compile Remove="AdditionalStringHelper.cs;ArrayHelper.cs;BasicTypeConverter.cs;BatchTransformations.cs;BitConvertor.cs;CollectionHelper.cs;ComparableHelper.cs;ConverterOld.cs;DateHelper.cs;DirectoryInfoHelper.cs;DiagnosticExtensions.cs;EnumHelper.cs;ExtensionHelper.cs;FileInfoHelper.cs;Helper.cs;HolidayHelper.cs;Inspect.cs;DiagnosticsProbe.cs;MiscHelper.cs;MeasurementExtensions.cs;RegExHelper.cs;RangeSemanticsHelper.cs;ObjectDelta.cs;Resilience.cs;SemanticStringComparer.cs;StopwatchHelper.cs;StreamHelper.cs;StreamExtensions.cs;StringHelper.cs;TimeSpanHelper.cs;Transform.cs;TransformationsHelper.cs;WebAndFileExtensions.cs;Properties\Resources.Designer.cs" />
    <!-- Owned by Transformations.Web. -->
    <Compile Remove="ConfigurationHelper.cs;CookieHelper.cs;QueryStringHelper.cs;ResponseHelper.cs;SessionHelper.cs;WebHelper.cs" />
    <!-- Owned by Transformations.Data. -->
    <Compile Remove="CollectionConvertor.cs;CsvHelper.cs;DataReaderHelper.cs;DataRowConverter.cs;SqlHelper.cs;StringHelper.SqlClient.cs;TransformationsHelper.SqlClient.cs" />
  </ItemGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" Visible="false" />
    <None Include="..\COOKBOOK.md" Pack="true" PackagePath="\" Visible="true" />
  </ItemGroup>
  <!-- Pack analyzers/generators into the NuGet package so consumers get them automatically. -->
  <Target Name="PackAnalyzer" BeforeTargets="_GetPackageFiles" Condition="'$(IsPackable)' == 'true'">
    <ItemGroup>
      <_PackageFiles Include="..\Transformations.Analyzers\bin\$(Configuration)\netstandard2.0\Transformations.Analyzers.dll" PackagePath="analyzers/dotnet/cs/Transformations.Analyzers.dll" />
      <_PackageFiles Include="..\Transformations.Analyzers.CodeFixes\bin\$(Configuration)\netstandard2.0\Transformations.Analyzers.CodeFixes.dll" PackagePath="analyzers/dotnet/cs/Transformations.Analyzers.CodeFixes.dll" />
      <_PackageFiles Include="..\Transformations.Mapping.Generator\bin\$(Configuration)\netstandard2.0\Transformations.Mapping.Generator.dll" PackagePath="analyzers/dotnet/cs/Transformations.Mapping.Generator.dll" />
    </ItemGroup>
  </Target>
</Project>



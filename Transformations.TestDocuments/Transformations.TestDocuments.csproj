<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Shared document builders for the test suites and the Transformations.Text smoke corpus generator.
    Not packaged. Test helpers only, so the XML documentation requirement does not apply.
  -->

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <IsPackable>false</IsPackable>
    <ImplicitUsings>enable</ImplicitUsings>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <RootNamespace>Transformations.TestDocuments</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Transformations.TextExtractor\Transformations.Text.csproj" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <PackageReference Include="MimeKit" Version="4.18.2" />
    <PackageReference Include="PdfPig" Version="0.1.16" />
  </ItemGroup>

</Project>
